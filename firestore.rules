rules_version = '2';
// Lockdown (2026-09-25): the old trial data is test-only and the previous rules let any signed-in
// user self-promote to admin. Until the Faz B rules land, only verified admin emails get in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['anadolusporduyuru@gmail.com', 'deancjx@gmail.com'];
    }
  }
}
